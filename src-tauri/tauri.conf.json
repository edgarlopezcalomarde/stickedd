{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stickedd",
  "version": "0.3.0",
  "identifier": "com.stickedd.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Stickedd",
        "visible": false,
        "width": 100,
        "height": 100
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCOUQ4RjMzOUExRDNERjIKUldUeVBSMmFNNCtkS3pHVmlyN2xRaTZkbDlMTnVjTEFjTG5TZ0h0NDZUL2pRSXdPL2p5cnBrenEK",
      "endpoints": [
        "https://github.com/edgarlopezcalomarde/stickedd/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}